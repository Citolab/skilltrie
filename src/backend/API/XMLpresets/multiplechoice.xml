<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item
  xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd"
  time-dependent="false"
  identifier=""
  title=""
  xml:lang=""
>
  <qti-response-declaration identifier="" base-type="identifier" cardinality="single">
  </qti-response-declaration>

  <!-- Outcome Declarations -->

  <qti-outcome-declaration identifier="FEEDBACK" cardinality="single" base-type="identifier" />

  <qti-outcome-declaration
    identifier="SCORE"
    cardinality="single"
    base-type="integer"
    normal-maximum="1"
  >
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>

  <qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="integer">
    <qti-default-value>
      <qti-value>1</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>

  <!-- Item body -->

  <qti-item-body>
    <!-- Question Text -->
  </qti-item-body>

  <!-- Response Processing -->

  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct" />

  <qti-modal-feedback
    identifier="correct"
    outcome-identifier="FEEDBACK"
    show-hide="show"
  >
    <qti-content-body>You answered correctly!</qti-content-body>
  </qti-modal-feedback>
</qti-assessment-item>