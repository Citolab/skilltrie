<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item
	xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd"
	time-dependent="false"
	identifier=""
	title=""
	xml:lang=""
>
	<qti-response-declaration identifier="" base-type="string" cardinality="single">
		<qti-correct-response>
			<qti-value base-type="string"></qti-value>
		</qti-correct-response>
	</qti-response-declaration>

	<!-- Outcome Declarations -->

	<qti-outcome-declaration identifier="FEEDBACK" cardinality="single" base-type="identifier" />

	<qti-outcome-declaration
		identifier="SCORE"
		cardinality="single"
		base-type="integer"
		normal-maximum="1"
	>
		<qti-default-value>
			<qti-value>0</qti-value>
		</qti-default-value>
	</qti-outcome-declaration>

	<qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="integer">
		<qti-default-value>
			<qti-value>1</qti-value>
		</qti-default-value>
	</qti-outcome-declaration>

	<!-- Item body -->

	<qti-item-body>
		<!-- Question Text -->
	</qti-item-body>

	<!-- Response Processing -->

	<qti-response-processing>
		<qti-response-condition>
			<qti-response-if>
				<!-- boolean expression -> equivalent to: if (response != correct_response)-->
				<qti-not>
					<qti-match>
						<!-- reference to identifier of <qti-response-declaration> -->
						<qti-variable identifier="" />
						<!-- reference to identifier of <qti-response-declaration> -->
						<qti-correct identifier="" />
					</qti-match>
				</qti-not>
				<!-- if statement block -> { ... } -->
				<qti-set-outcome-value identifier="SCORE"> <!-- Set score to 0 -->
					<qti-base-value base-type="integer">0</qti-base-value>
				</qti-set-outcome-value>
				<qti-set-outcome-value identifier="FEEDBACK">
					<qti-base-value base-type="identifier">
						null
					</qti-base-value>
				</qti-set-outcome-value>
			</qti-response-if>
			<!-- else statement -->
			<qti-response-else>
				<!-- toggle the modal feedback that has identifier "correct" -->
				<!-- remove this if feedback should not show up -->
				<qti-set-outcome-value identifier="FEEDBACK">
					<qti-base-value base-type="identifier">
						<!-- reference to the identifier of <qti-modal-feedback> -->
								correct
							</qti-base-value>
				</qti-set-outcome-value>
				<qti-set-outcome-value identifier="SCORE"> <!-- Set score to maxscore -->
					<qti-variable identifier="MAXSCORE" />
				</qti-set-outcome-value>
			</qti-response-else>
		</qti-response-condition>
	</qti-response-processing>

	<qti-modal-feedback
		identifier="correct"
		outcome-identifier="FEEDBACK"
		show-hide="show"
	>
		<qti-content-body>You answered correctly!</qti-content-body>
	</qti-modal-feedback>
</qti-assessment-item>